source "Kconfig.zephyr"

menu "Wireless time synchronization"

choice TIME_SYNC_ROLE
	prompt "Time sync role"
	default TIME_SYNC_ROLE_SLAVE

config TIME_SYNC_ROLE_MASTER
	bool "Master"

config TIME_SYNC_ROLE_SLAVE
	bool "Slave"

endchoice

config TIME_SYNC_NETWORK_ID
	hex "Private sync network ID"
	default 0x54534e52

config TIME_SYNC_RF_CHANNEL
	int "Raw RADIO frequency offset from 2400 MHz"
	default 40
	range 0 100

config TIME_SYNC_INTERVAL_US
	int "Sync beacon interval in microseconds"
	default 100000

config TIME_SYNC_PPS_PERIOD_US
	int "PPS period in microseconds"
	default 1000000

config TIME_SYNC_PPS_WIDTH_US
	int "PPS pulse width in microseconds"
	default 100

config TIME_SYNC_RADIO_DELAY_US
	int "Calibrated residual radio reference delay in microseconds"
	default 0

config TIME_SYNC_RADIO_TXEN_TO_ADDRESS_US
	int "Master TXEN to RADIO ADDRESS reference delay in microseconds"
	default 88

config TIME_SYNC_MASTER_TX_TIMESLOT_LENGTH_US
	int "Master RADIO TX timeslot length in microseconds"
	default 3000
	range 1000 25000
	depends on TIME_SYNC_ROLE_MASTER

config TIME_SYNC_MASTER_TX_START_OFFSET_US
	int "Master RADIO TXEN offset from granted timeslot start"
	default 500
	range 200 20000
	depends on TIME_SYNC_ROLE_MASTER

config TIME_SYNC_BLE
	bool "Enable Bluetooth control channel"
	default y

config TIME_SYNC_BLE_DEVICE_NAME_PREFIX
	string "Bluetooth device name prefix"
	default "TS"
	depends on TIME_SYNC_BLE

config TIME_SYNC_MASTER_BLE_AUTO_START
	bool "Automatically start master BLE scanning after RADIO TX is stable"
	default n
	depends on TIME_SYNC_BLE && TIME_SYNC_ROLE_MASTER

config TIME_SYNC_TIMESLOT_LENGTH_US
	int "MPSL raw RADIO timeslot length in microseconds"
	default 25000 if TIME_SYNC_ROLE_MASTER
	default 100000 if TIME_SYNC_ROLE_SLAVE
	range 100 100000

config TIME_SYNC_TIMESLOT_END_MARGIN_US
	int "Margin before MPSL timeslot end used to stop raw RADIO"
	default 250
	range 100 10000

config TIME_SYNC_RX_START_OFFSET_US
	int "Slave RXEN offset from granted timeslot start"
	default 1000
	range 200 20000

config TIME_SYNC_TIMESLOT_REQUEST_TIMEOUT_US
	int "Timeout for earliest MPSL timeslot requests"
	default 200000
	range 1000 256000000

config TIME_SYNC_RX_ACQUIRE_WINDOW_US
	int "Slave acquire RX window length in microseconds"
	default 100000
	range 1000 100000

config TIME_SYNC_RX_ACQUIRE_PERIOD_US
	int "Slave acquire RX gap in microseconds"
	default 2000
	range 1000 1000000

config TIME_SYNC_RX_LOCKED_PRE_MARGIN_US
	int "Slave locked RX pre-margin before predicted beacon"
	default 1500
	range 100 20000

config TIME_SYNC_RX_LOCKED_POST_MARGIN_US
	int "Slave locked RX post-margin after predicted beacon"
	default 2500
	range 100 20000

config TIME_SYNC_RX_RECOVERY_PRE_MARGIN_US
	int "Slave recovery RX pre-margin before predicted beacon"
	default 10000
	range 1000 50000

config TIME_SYNC_RX_RECOVERY_POST_MARGIN_US
	int "Slave recovery RX post-margin after predicted beacon"
	default 10000
	range 1000 50000

config TIME_SYNC_RX_WINDOW_GUARD_US
	int "Slave RX window guard time in microseconds"
	default 300
	range 0 5000

config TIME_SYNC_RX_MISSED_TO_ACQUIRE
	int "Missed locked windows before returning to acquire mode"
	default 3
	range 1 20

config TIME_SYNC_STATUS_INTERVAL_MS
	int "Status log interval in milliseconds"
	default 1000

config TIME_SYNC_LED_HEARTBEAT
	bool "Blink board LED as a runtime heartbeat"
	default y

config TIME_SYNC_LED_HEARTBEAT_PERIOD_MS
	int "LED heartbeat toggle period in milliseconds"
	default 1000
	depends on TIME_SYNC_LED_HEARTBEAT

endmenu
