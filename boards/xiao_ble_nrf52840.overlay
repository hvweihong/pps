&timer1 {
	status = "okay";
};

&timer3 {
	status = "okay";
};

/ {
	aliases {
		bridge-uart = &uart0;
		time-uart = &uart1;
		pps-out = &pps_out;
		debug-out = &debug_out;
		pps-in = &pps_in;
	};

	time_sync_gpios {
		compatible = "gpio-leds";

		pps_out: pps_out {
			gpios = <&gpio0 3 GPIO_ACTIVE_HIGH>;
			label = "PPS output";
		};

		debug_out: debug_out {
			gpios = <&gpio0 28 GPIO_ACTIVE_HIGH>;
			label = "Debug timing output";
		};

		pps_in: pps_in {
			gpios = <&gpio0 2 GPIO_ACTIVE_HIGH>;
			label = "Reserved PPS input";
		};
	};
};

&uart1 {
	compatible = "nordic,nrf-uarte";
	status = "okay";
	current-speed = <9600>;
	pinctrl-0 = <&uart1_default>;
	pinctrl-1 = <&uart1_sleep>;
	pinctrl-names = "default", "sleep";
};

&pinctrl {
	uart1_default: uart1_default {
		group1 {
			psels = <NRF_PSEL(UART_TX, 0, 4)>;
		};
		group2 {
			psels = <NRF_PSEL(UART_RX, 0, 5)>;
			bias-pull-up;
		};
	};

	uart1_sleep: uart1_sleep {
		group1 {
			psels = <NRF_PSEL(UART_TX, 0, 4)>,
				<NRF_PSEL(UART_RX, 0, 5)>;
			low-power-enable;
		};
	};
};
